{
  "name": "@flatbread/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flatbread's documentation site, built on Flatbread.",
  "scripts": {
    "dev": "flatbread start --watch -- next dev --turbopack",
    "build": "flatbread start -- next build",
    "prebuild": "pnpm check",
    "postbuild": "node scripts/check-export.mjs",
    "codegen": "flatbread codegen",
    "codegen:watch": "flatbread codegen --watch",
    "check:codegen": "flatbread codegen && git diff --exit-code HEAD -- generated/graphql.ts",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "flatbread start -- node scripts/check-content-parity.mjs",
    "check": "pnpm check:links && pnpm check:content && pnpm check:codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "npx --yes serve out"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.11.0",
    "next": "15.5.23",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.10",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "flatbread": "workspace:*",
    "jsdom": "16.7.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  }
}
