{
  "name": "@flatbread/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flatbread's documentation site, built on Flatbread.",
  "scripts": {
    "dev": "flatbread start --watch -- next dev --turbopack",
    "build": "flatbread start -- next build",
    "prebuild": "node scripts/check-links.mjs",
    "codegen": "flatbread codegen",
    "codegen:watch": "flatbread codegen --watch",
    "check:links": "node scripts/check-links.mjs",
    "serve": "npx --yes serve out"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.11.0",
    "motion": "^13.1.0",
    "next": "15.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.10",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "flatbread": "workspace:*",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  }
}
