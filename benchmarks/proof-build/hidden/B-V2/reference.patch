+/**
+ * Scales the selected layers, and everything inside them, by `percent`
+ * about the centre of the selection, as one resize command. Stored values
+ * are not rounded.
+ */
+function scaleSelection(ctx: EditorContext, input?: string): void {
+  const percent = parseExpression((input ?? '').replace(/%\s*$/, ''));
+  if (percent === null || !(percent > 0)) return;
+  const { doc } = ctx;
+  const ids = topmostOnly(
+    doc,
