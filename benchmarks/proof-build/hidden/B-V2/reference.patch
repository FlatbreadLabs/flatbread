+  );
+  const bounds = selectionBounds(doc, ids);
+  if (!bounds) return;
+  const c = centre(bounds);
+  const k = percent / 100;
+  const items: GeometryItem[] = [];
+  for (const id of ids)
+    for (const node of [doc.require(id), ...descendants(doc, id)])
+      if (node.type !== 'group')
+        items.push({
+          id: node.id,
+          x: c.x + (node.x - c.x) * k,
+          y: c.y + (node.y - c.y) * k,
+          width: node.width * k,
+          height: node.height * k,
+        });
+  if (items.length)
+    ctx.dispatch(command('resize', { items: items as unknown as Json[] }), {
+      label: 'Scale selection',
+    });
+}
