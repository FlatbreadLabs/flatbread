+/** Key repeats closer together than this belong to one hold. */
+export const REPEAT_WINDOW_MS = 400;
+
+const lastNudge = new WeakMap<KeyContext, { gesture: string; at: number }>();
+
 function nudge(chord: string, direction: Direction, large: boolean): Binding {
   return {
     chord,
-    run(ctx: KeyContext) {
+    run(ctx: KeyContext, event) {
       const ids = ctx.selection.ids();
       if (!ids.length) return;
-      ctx.dispatch(command('nudge', { ids, ...nudgeDelta(direction, large) }));
+      const now = ctx.now();
+      const last = lastNudge.get(ctx);
+      const gesture =
+        event.repeat && last && now - last.at <= REPEAT_WINDOW_MS
+          ? last.gesture
+          : ctx.newGesture();
+      lastNudge.set(ctx, { gesture, at: now });
+      ctx.dispatch(command('nudge', { ids, ...nudgeDelta(direction, large) }), {
+        gesture,
+      });
     },
   };
 }
