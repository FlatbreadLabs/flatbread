@@ -0,0 +1,21 @@
+import type { SectionDescriptor } from '../schema.ts';
+import { field } from '../schema.ts';
+import { command } from '../../commands/types.ts';
+import type { FrameNode } from '../../model/types.ts';
+
+export const gridSection: SectionDescriptor = {
+  name: 'grid',
+  title: 'Layout grid',
+  fields: [
+    field({
+      label: 'Layout grid',
+      kind: 'grid',
+      min: 0,
+      appliesTo: (node) => node.type === 'frame',
+      read: (node) => (node as FrameNode).layoutGrid,
+      write: (node, value) => [
+        command('set-prop', { id: node.id, key: 'layoutGrid', value }),
+      ],
+    }),
+  ],
+};
