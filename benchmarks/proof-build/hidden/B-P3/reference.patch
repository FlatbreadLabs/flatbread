diff --git a/src/persist/migrations/v5-v6.ts b/src/persist/migrations/v5-v6.ts
new file mode 100644
index 0000000..13a324f
--- /dev/null
+++ b/src/persist/migrations/v5-v6.ts
@@ -0,0 +1,14 @@
+import type { RawFile } from './index.ts';
+
+/** Version 6 gives every frame a layout grid size, 0 meaning the grid is off. */
+export function v5ToV6(file: RawFile): RawFile {
+  const nodes: Record<string, Record<string, unknown>> = {};
+  for (const [id, node] of Object.entries(
+    file.nodes as Record<string, Record<string, unknown>>
+  ))
+    nodes[id] =
+      node.type === 'frame'
+        ? { ...node, layoutGrid: node.layoutGrid ?? 0 }
+        : node;
+  return { ...file, version: 6, nodes };
+}
