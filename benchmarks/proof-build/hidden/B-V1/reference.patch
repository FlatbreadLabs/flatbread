index 0000000..30471cd
--- /dev/null
+++ b/src/selection/box.ts
@@ -0,0 +1,25 @@
+import type { Document } from '../model/document.ts';
+import type { Rect } from '../model/geometry.ts';
+import { nodeBounds, rectContainsRect } from '../model/geometry.ts';
+import { isContainer } from '../model/types.ts';
+import { isInteractive } from './rules.ts';
+
+/**
+ * What a selection box selects: every layer that lies fully inside `box`.
+ * A container the box covers is taken whole; for one it only partly covers,
+ * the box reaches the layers inside. Like a click, it skips hidden and
+ * locked layers and everything inside them.
+ */
+export function boxSelect(doc: Document, box: Rect): string[] {
+  const out: string[] = [];
+  const visit = (parent: string | null) => {
+    for (const id of doc.children(parent)) {
+      if (!isInteractive(doc, id)) continue;
+      const node = doc.require(id);
+      if (rectContainsRect(box, nodeBounds(node))) out.push(id);
+      else if (isContainer(node)) visit(id);
+    }
+  };
+  visit(null);
+  return out;
+}
