--- /dev/null
+++ b/src/selection/same.ts
@@ -0,0 +1,16 @@
+import type { Document } from '../model/document.ts';
+import { firstFill } from '../model/style.ts';
+import { walk } from '../model/query.ts';
+import { isInteractive } from './rules.ts';
+
+/** `id` and every other layer whose fill is the same colour as its fill. */
+export function sameFill(doc: Document, id: string): string[] {
+  const color = firstFill(doc.require(id))?.color;
+  if (!color) return [];
+  const matches: string[] = [];
+  walk(doc, (node) => {
+    if (node.id === id || firstFill(node)?.color !== color) return;
+    if (isInteractive(doc, node.id)) matches.push(node.id);
+  });
+  return [id, ...matches];
+}
