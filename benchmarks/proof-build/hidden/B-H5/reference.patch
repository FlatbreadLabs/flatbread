+++ b/src/selection/same.ts
@@ -0,0 +1,35 @@
+import type { Document } from '../model/document.ts';
+import type { SceneNode } from '../model/types.ts';
+import { firstFill } from '../model/style.ts';
+import { walk } from '../model/query.ts';
+import { ancestors, descendants } from '../model/tree.ts';
+import { isInteractive } from './rules.ts';
+
+/** The top-level frame that holds `id`, or null when it sits outside every frame. */
+function topFrame(doc: Document, id: string): string | null {
+  const frames = ancestors(doc, id).filter((a) => a.type === 'frame');
+  return frames.length ? frames[frames.length - 1].id : null;
+}
+
+/**
+ * `id` and the layers whose fill is the same colour as its fill. The search
+ * stays inside the top-level frame that holds `id`, at any depth; a layer
+ * outside every frame looks only at the other layers outside frames.
+ */
+export function sameFill(doc: Document, id: string): string[] {
+  const color = firstFill(doc.require(id))?.color;
+  if (!color) return [];
+  const frame = topFrame(doc, id);
+  const pool: SceneNode[] = [];
+  if (frame !== null) pool.push(...descendants(doc, frame));
+  else
+    walk(doc, (node) => {
+      if (node.type === 'frame') return false;
+      pool.push(node);
+    });
+  const matches = pool
+    .filter((node) => node.id !== id && firstFill(node)?.color === color)
+    .filter((node) => isInteractive(doc, node.id))
+    .map((node) => node.id);
+  return [id, ...matches];
+}
