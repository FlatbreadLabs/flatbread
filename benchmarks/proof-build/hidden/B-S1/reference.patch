+/**
+ * Number keys set the selection's opacity: 1 is 10%, 9 is 90% and 0 is 100%.
+ * A key types the percentage into the Opacity field, so it does exactly what
+ * the field does.
+ */
+function opacityKey(digit: number): Binding {
+  const opacity = appearanceSection.fields.find((f) => f.label === 'Opacity')!;
+  return {
+    chord: String(digit),
+    run(ctx: KeyContext) {
+      if (ctx.selection.isEmpty()) return;
+      commitField(ctx, opacity, `${digit === 0 ? 100 : digit * 10}%`);
+    },
+  };
+}
+
 export const canvasBindings: readonly Binding[] = [
+  ...[1, 2, 3, 4, 5, 6, 7, 8, 9, 0].map(opacityKey),
