+/**
+ * Number keys set the selection's opacity: 1 is 10%, 9 is 90% and 0 is 100%.
+ * Groups carry no opacity of their own, so a group's value goes to every
+ * styled layer inside it, as the Opacity field does.
+ */
+function opacityKey(digit: number): Binding {
+  const value = clampOpacity(digit === 0 ? 1 : digit / 10);
+  return {
+    chord: String(digit),
+    run(ctx: KeyContext) {
+      const targets = new Set<string>();
+      for (const id of ctx.selection.ids()) {
+        const node = ctx.doc.require(id);
+        if (node.type !== 'group') targets.add(id);
+        else
+          for (const inner of descendants(ctx.doc, id))
+            if (inner.type !== 'group') targets.add(inner.id);
+      }
+      if (!targets.size) return;
+      const gesture = ctx.newGesture();
+      for (const id of targets)
+        ctx.dispatch(command('set-prop', { id, key: 'opacity', value }), {
+          label: 'Set Opacity',
+          gesture,
+        });
+    },
+  };
+}
+
 export const canvasBindings: readonly Binding[] = [
+  ...[1, 2, 3, 4, 5, 6, 7, 8, 9, 0].map(opacityKey),
