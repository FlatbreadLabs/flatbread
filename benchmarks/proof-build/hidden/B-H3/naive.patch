+
+/**
+ * Puts `ids` into a new frame that fits tightly around them, placed where
+ * the frontmost of them was, then selects the frame. The layers keep their
+ * places on the canvas. Returns the frame's id, or null when nothing can be
+ * framed.
+ */
+export function frameNodes(
+  ctx: EditorContext,
+  ids: readonly string[]
+): string | null {
+  const { doc } = ctx;
+  const members = sortByPaintOrder(
+    doc,
+    topmostOnly(
+      doc,
+      ids.filter((id) => doc.has(id))
+    )
+  );
+  if (!members.length) return null;
+  const parent = commonParent(doc, members);
+  const front = members[members.length - 1];
+  let anchor = front;
+  while (doc.require(anchor).parent !== parent)
+    anchor = doc.require(anchor).parent!;
+  const bounds = selectionBounds(doc, members)!;
+  const frame = createFrame(ctx.ids, { ...bounds });
+  const frameId = frame.id;
+  ctx.batch('Frame selection', () => {
+    ctx.dispatch(
+      command('insert', {
+        nodes: [frame] as unknown as Json[],
+        parent,
+        index: indexInParent(doc, anchor) + 1,
+      })
+    );
+    members.forEach((id, i) => {
+      ctx.dispatch(command('reorder', { id, parent: frameId, index: i }), {
+        select: i === members.length - 1 ? [frameId] : undefined,
+      });
+    });
+  });
+  return frameId;
+}
