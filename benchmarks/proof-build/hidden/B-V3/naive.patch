diff --git a/src/commands/builtin/ungroup.ts b/src/commands/builtin/ungroup.ts
new file mode 100644
index 0000000..850590d
--- /dev/null
+++ b/src/commands/builtin/ungroup.ts
@@ -0,0 +1,35 @@
+import { indexInParent } from '../../model/tree.ts';
+import type { EditorContext } from '../types.ts';
+import { command } from '../types.ts';
+
+/**
+ * Moves the children of every selected group into the group's parent, in
+ * the group's place, and deletes the emptied groups, as one history entry.
+ * The freed children are selected first, so they stay selected. Returns
+ * false when no group is selected.
+ */
+export function ungroupSelection(ctx: EditorContext): boolean {
+  const { doc } = ctx;
+  const selected = ctx.selection.ids().filter((id) => doc.has(id));
+  const groups = selected.filter((id) => doc.require(id).type === 'group');
+  if (!groups.length) return false;
+  const after = selected.flatMap((id) =>
+    groups.includes(id) ? [...doc.children(id)] : [id]
+  );
+  ctx.selection.set(after);
+  ctx.batch('Ungroup', () => {
+    groups.forEach((group) => {
+      const parent = doc.require(group).parent;
+      for (const child of [...doc.children(group)])
+        ctx.dispatch(
+          command('reorder', {
+            id: child,
+            parent,
+            index: indexInParent(doc, group),
+          })
+        );
+      ctx.dispatch(command('delete', { ids: [group] }));
+    });
+  });
+  return true;
+}
