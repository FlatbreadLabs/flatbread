+    nodes: copySubtree(ctx, id, DUPLICATE_OFFSET, DUPLICATE_OFFSET),
+  }));
+  const select = copies.map((c) => c.nodes[0].id);
+  ctx.batch('Duplicate', () => {
+    // Front to back, so the indexes of the originals still to copy hold.
+    [...copies].reverse().forEach(({ id, nodes }, i) => {
+      ctx.dispatch(
+        command('insert', {
+          nodes: nodes as unknown as Json[],
+          parent: doc.require(id).parent,
+          index: indexInParent(doc, id) + 1,
+        }),
+        { select: i === copies.length - 1 ? select : undefined }
+      );
+    });
+  });
+}
