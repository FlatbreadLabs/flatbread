+/** `id` and everything inside it, root first, with new ids, moved by (dx, dy). */
+function copySubtree(
+  ctx: EditorContext,
+  id: string,
+  dx: number,
+  dy: number
+): SceneNode[] {
+  const nodes = [ctx.doc.require(id), ...descendants(ctx.doc, id)];
+  const fresh = new Map(nodes.map((n) => [n.id, ctx.ids.next(n.type)]));
+  return nodes.map((n) => {
+    const copy = structuredClone(n);
+    copy.id = fresh.get(n.id)!;
+    copy.parent =
+      n.parent !== null && fresh.has(n.parent)
+        ? fresh.get(n.parent)!
+        : n.parent;
+    copy.x += dx;
+    copy.y += dy;
+    if (isContainer(copy))
+      copy.children = copy.children.map((c) => fresh.get(c)!);
+    return copy;
+  });
+}
