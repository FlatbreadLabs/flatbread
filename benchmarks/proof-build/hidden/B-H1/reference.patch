diff --git a/src/editor.ts b/src/editor.ts
index c964d1d..aa2b309 100644
--- a/src/editor.ts
+++ b/src/editor.ts
@@ -92,6 +92,30 @@ export function createEditor(options: EditorOptions = {}) {
   doc.events.on('load', ({ name }) =>
     plugins.emit('documentload', Object.freeze({ name }))
   );
+  // Layer names as plugins last heard them, so a rename from anywhere
+  // (palette, layers panel, undo, redo) is seen once, with its old name.
+  const names = new Map<string, string>();
+  doc.events.on('change', ({ ids: changed }) => {
+    for (const id of changed) {
+      const node = doc.get(id);
+      if (!node) {
+        names.delete(id);
+        continue;
+      }
+      const before = names.get(id);
+      names.set(id, node.name);
+      if (before !== undefined && before !== node.name)
+        plugins.emitContent(
+          'layerrename',
+          Object.freeze({ id, before, after: node.name }),
+          Object.freeze({ id })
+        );
+    }
+  });
+  doc.events.on('load', () => {
+    names.clear();
+    for (const node of doc.all()) names.set(node.id, node.name);
+  });
   history.events.on('change', ({ canUndo, canRedo }) =>
     plugins.emit('historychange', Object.freeze({ canUndo, canRedo }))
   );
