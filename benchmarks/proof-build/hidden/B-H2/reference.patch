+import type { Document } from '../../model/document.ts';
+import type { TextNode } from '../../model/types.ts';
+import { isText } from '../../model/types.ts';
+import { autoHeight } from '../../model/text.ts';
+import { clamp } from '../../util/math.ts';
+import type { Command } from '../types.ts';
+import { command } from '../types.ts';
+
+export const MIN_FONT_SIZE = 1;
+export const MAX_FONT_SIZE = 1000;
+
+/** The type scale a step moves along. */
+export const TYPE_SCALE: readonly number[] = [
+  8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 48, 64, 72, 96,
+];
+
+/**
+ * The size one step up or down from `size`: the next size on the type
+ * scale in that direction, so 13 goes up to 14 and down to 12. Below the
+ * scale a step is 1 px, above it 8 px.
+ */
+export function stepFontSize(size: number, up: boolean): number {
+  const first = TYPE_SCALE[0];
+  const last = TYPE_SCALE[TYPE_SCALE.length - 1];
+  if (up) {
+    if (size < first) return Math.min(first, size + 1);
+    if (size >= last) return size + 8;
+    return TYPE_SCALE.find((s) => s > size)!;
+  }
+  if (size <= first) return size - 1;
+  if (size > last) return Math.max(last, size - 8);
+  return [...TYPE_SCALE].reverse().find((s) => s < size)!;
+}
+
+/** The commands that step every text layer in `ids` one size up or down, height included. */
+export function fontSizeCommands(
+  doc: Document,
+  ids: readonly string[],
+  up: boolean
+): Command[] {
+  const out: Command[] = [];
+  for (const id of ids) {
+    const node = doc.get(id);
+    if (!node || !isText(node)) continue;
+    const fontSize = clamp(
+      stepFontSize(node.fontSize, up),
+      MIN_FONT_SIZE,
+      MAX_FONT_SIZE
+    );
+    if (fontSize === node.fontSize) continue;
+    const next: TextNode = { ...node, fontSize };
+    out.push(
+      command('set-prop', { id, key: 'fontSize', value: fontSize }),
+      command('set-prop', { id, key: 'height', value: autoHeight(next) })
+    );
+  }
+  return out;
+}
