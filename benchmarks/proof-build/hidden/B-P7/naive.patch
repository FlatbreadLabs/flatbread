+/** A layer's look, as Copy style takes it and Paste style gives it. */
+interface CopiedStyle {
+  fills: Paint[];
+  strokes: Stroke[];
+  opacity: number;
+}
+
+/** The style each editor last copied, by its document. */
+const copiedStyles = new WeakMap<object, CopiedStyle>();
+
+const styledSelection = (ctx: EditorContext) =>
+  ctx.selection.ids().filter((id) => {
+    const node = ctx.doc.get(id);
+    return node !== undefined && isStyled(node);
+  });
+
+/** Gives every selected layer but groups the copied style. */
+function pasteStyle(ctx: EditorContext): void {
+  const style = copiedStyles.get(ctx.doc);
+  const targets = styledSelection(ctx);
+  if (!style || !targets.length) return;
+  for (const id of targets)
+    for (const key of ['fills', 'strokes', 'opacity'] as const)
+      ctx.dispatch(
+        command('set-prop', {
+          id,
+          key,
+          value: structuredClone(style[key]) as unknown as Json,
+        }),
+        { label: 'Paste style' }
+      );
+}
