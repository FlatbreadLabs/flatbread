+import type { SectionDescriptor } from '../schema.ts';
+import { field } from '../schema.ts';
+import type { TextNode } from '../../model/types.ts';
+import { isText } from '../../model/types.ts';
+
+/** Read-only counts for text layers. */
+export const textInfoSection: SectionDescriptor = {
+  name: 'text-info',
+  title: 'Text info',
+  fields: [
+    field({
+      label: 'Characters',
+      kind: 'number',
+      readonly: true,
+      appliesTo: isText,
+      read: (node) => (node as TextNode).text.replace(/\n/g, '').length,
+      write: () => [],
+    }),
+    field({
+      label: 'Words',
+      kind: 'number',
+      readonly: true,
+      appliesTo: isText,
+      read: (node) =>
+        (node as TextNode).text.split(/\s+/).filter(Boolean).length,
+      write: () => [],
+    }),
+  ],
+};
