+import type { Document } from '../../model/document.ts';
+import type { Paint, Stroke } from '../../model/types.ts';
+import { isStyled } from '../../model/types.ts';
+import { walk } from '../../model/query.ts';
+import { ancestors } from '../../model/tree.ts';
+import { parseColor } from '../../model/style.ts';
+import type { Command, Json } from '../types.ts';
+import { command } from '../types.ts';
+
+/** Reads "#FF0000 #00AA00": the colour to find and the colour to use. */
+export function parseColourPair(
+  input: string | undefined
+): { from: string; to: string } | null {
+  const parts = (input ?? '').trim().split(/\s+/);
+  if (parts.length !== 2) return null;
+  const from = parseColor(parts[0]);
+  const to = parseColor(parts[1]);
+  return from && to ? { from, to } : null;
+}
+
+/**
+ * The set-prop commands that give every fill and stroke in `from` the
+ * colour `to`, across the whole document. Locked layers, and everything
+ * inside a locked container, are left alone; hidden layers change like any
+ * other.
+ */
+export function recolourCommands(
+  doc: Document,
+  from: string,
+  to: string
+): Command[] {
+  const out: Command[] = [];
+  walk(doc, (node) => {
+    if (!isStyled(node)) return;
+    // Locked layers, and everything inside a locked group or frame, keep
+    // their colours.
+    if (node.locked || ancestors(doc, node.id).some((a) => a.locked)) return;
+    const swap = <T extends Paint | Stroke>(paints: T[]): T[] =>
+      paints.map((p) => (p.color === from ? { ...p, color: to } : p));
+    if (node.fills.some((p) => p.color === from))
+      out.push(
+        command('set-prop', {
+          id: node.id,
+          key: 'fills',
+          value: swap(node.fills) as unknown as Json[],
+        })
+      );
+    if (node.strokes.some((s) => s.color === from))
+      out.push(
+        command('set-prop', {
+          id: node.id,
+          key: 'strokes',
+          value: swap(node.strokes) as unknown as Json[],
+        })
+      );
+  });
+  return out;
+}
