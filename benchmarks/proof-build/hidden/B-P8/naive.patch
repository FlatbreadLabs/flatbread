@@ -0,0 +1,24 @@
+/** The basic colour names early files could hold, as upper-case hex. */
+export const BASIC_COLOURS: Readonly<Record<string, string>> = {
+  BLACK: '#000000',
+  SILVER: '#C0C0C0',
+  GRAY: '#808080',
+  WHITE: '#FFFFFF',
+  MAROON: '#800000',
+  RED: '#FF0000',
+  PURPLE: '#800080',
+  FUCHSIA: '#FF00FF',
+  GREEN: '#008000',
+  LIME: '#00FF00',
+  OLIVE: '#808000',
+  YELLOW: '#FFFF00',
+  NAVY: '#000080',
+  BLUE: '#0000FF',
+  TEAL: '#008080',
+  AQUA: '#00FFFF',
+};
+
+/** `color` as hex when it is a basic colour name, in any case; else as it is. */
+export function namedToHex(color: string): string {
+  return BASIC_COLOURS[color.toUpperCase()] ?? color;
+}
