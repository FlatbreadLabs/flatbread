diff --git a/src/persist/migrations/v5-v6.ts b/src/persist/migrations/v5-v6.ts
new file mode 100644
index 0000000..d0b0d7c
--- /dev/null
+++ b/src/persist/migrations/v5-v6.ts
@@ -0,0 +1,54 @@
+import type { RawFile } from './index.ts';
+
+/** The basic colour names early files could hold, as upper-case hex. */
+export const BASIC_COLOURS: Readonly<Record<string, string>> = {
+  BLACK: '#000000',
+  SILVER: '#C0C0C0',
+  GRAY: '#808080',
+  WHITE: '#FFFFFF',
+  MAROON: '#800000',
+  RED: '#FF0000',
+  PURPLE: '#800080',
+  FUCHSIA: '#FF00FF',
+  GREEN: '#008000',
+  LIME: '#00FF00',
+  OLIVE: '#808000',
+  YELLOW: '#FFFF00',
+  NAVY: '#000080',
+  BLUE: '#0000FF',
+  TEAL: '#008080',
+  AQUA: '#00FFFF',
+};
+
+const hex = (color: unknown): unknown =>
+  typeof color === 'string'
+    ? BASIC_COLOURS[color.toUpperCase()] ?? color
+    : color;
+
+const paints = (list: unknown): unknown =>
+  Array.isArray(list)
+    ? list.map((paint) =>
+        paint && typeof paint === 'object'
+          ? { ...paint, color: hex((paint as { color?: unknown }).color) }
+          : paint
+      )
+    : list;
+
+/**
+ * Version 1 and 2 files could name a colour instead of giving its hex code,
+ * and the version 2 to 3 step kept the name, upper-cased. Version 6 holds
+ * hex only: every fill and stroke colour that is a basic colour name becomes
+ * its hex code.
+ */
+export function v5ToV6(file: RawFile): RawFile {
+  const nodes: Record<string, Record<string, unknown>> = {};
+  for (const [id, node] of Object.entries(
+    file.nodes as Record<string, Record<string, unknown>>
+  )) {
+    const out = { ...node };
+    if ('fills' in out) out.fills = paints(out.fills);
+    if ('strokes' in out) out.strokes = paints(out.strokes);
+    nodes[id] = out;
+  }
+  return { ...file, version: 6, nodes };
+}
